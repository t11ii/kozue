{
  "name": "kozue",
  "private": true,
  "version": "0.1.0",
  "description": "Kozue — a fast, lightweight mind map app for macOS and Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:html": "vite build && node scripts/inline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" vite.config.ts index.html"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
